#!/bin/sh

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun is required to format staged files" >&2
  exit 1
fi

echo "pre-commit: formatting staged files with bun fmt"
bun fmt --staged

cpp_files=$(git diff --cached --name-only --diff-filter=ACMR -- \
  '*.c' '*.cc' '*.cpp' '*.cxx' '*.h' '*.hh' '*.hpp' '*.hxx')

if [ -n "$cpp_files" ]; then
  if ! command -v clang-format >/dev/null 2>&1; then
    echo "pre-commit: clang-format is required for staged C/C++ files" >&2
    echo "Install clang-format, then retry the commit." >&2
    exit 1
  fi

  echo "pre-commit: formatting staged C/C++ files with clang-format"
  printf '%s\n' "$cpp_files" | while IFS= read -r file; do
    [ -n "$file" ] || continue
    clang-format -i --style=file -- "$file"
    git add -- "$file"
  done
fi
