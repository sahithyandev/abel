---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const { frontmatter = {}, title: directTitle, description: directDescription, showToc: directShowToc = false, wide = false } = Astro.props;
const title = frontmatter.title ?? directTitle ?? 'Abel — Language documentation';
const description = frontmatter.description ?? directDescription ?? 'The Abel programming language documentation.';
const showToc = frontmatter.showToc ?? directShowToc;
---
<!doctype html>
<html lang="en" data-type="software" data-site-kind="software">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="page-type" content="documentation" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'playground-page': wide }}>
    <header class="site-header">
      <a class="wordmark" href={base}>abel<span>.</span></a>
      <nav aria-label="Primary navigation">
        <a href={`${base}playground/`}>Playground</a>
        <a href={`${base}specification/`}>Language spec</a>
        <a href={`${base}#about`}>About Abel</a>
      </nav>
    </header>
    <main class:list={{ 'docs-shell': showToc, 'page-shell': !showToc, 'wide-shell': wide }}>
      {showToc && <aside class="toc">
        <p>On this page</p>
        <nav aria-label="Specification sections">
          <a href="#1-design-goals">Design goals</a>
          <a href="#2-programs-and-execution">Programs and execution</a>
          <a href="#3-lexical-rules">Lexical rules</a>
          <a href="#4-statements">Statements</a>
          <a href="#5-expressions">Expressions</a>
          <a href="#6-functions-and-calls">Functions and calls</a>
          <a href="#7-arrays">Arrays</a>
          <a href="#8-built-in-functions">Built-in functions</a>
          <a href="#9-errors">Errors</a>
          <a href="#10-compatibility-policy">Compatibility</a>
          <a href="#11-non-normative-roadmap">Roadmap</a>
          <a href="#12-complete-example">Complete example</a>
        </nav>
      </aside>}
      <article class="prose"><slot /></article>
    </main>
    <footer><span>abel.</span><span>Language specification v0.1</span></footer>
  </body>
</html>
